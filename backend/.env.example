# ==========================================
# RE:SET Backend Environment Template (.env.example)
# ==========================================

# Project Settings
PROJECT_NAME="RE:SET Wellness Engine"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase PostgreSQL Configuration
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=your-database-host
DB_PORT=6543
DB_NAME=postgres

# Direct Database URL (Optional override)
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME

# Fallback SQLite DB
SQLITE_URL=sqlite:///./reset_wellness.db

# AIML API Configuration
AIML_API_KEY=your-aiml-api-key-here
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini
AIML_FALLBACK_MODEL=gpt-4o

# CORS & Allowed Origins
FRONTEND_URL=http://localhost:5173
ALLOW_ALL_ORIGINS=false
